<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.fulmine1000.jarvis</string>

    <key>ProgramArguments</key>
    <array>
        <string>__JARVIS_PYTHON__</string>
        <string>__JARVIS_ROOT__/jarvis.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__JARVIS_ROOT__</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>ProcessType</key>
    <string>Interactive</string>

    <key>StandardOutPath</key>
    <string>__JARVIS_ROOT__/logs/avvio_mac.log</string>

    <key>StandardErrorPath</key>
    <string>__JARVIS_ROOT__/logs/avvio_mac_error.log</string>
</dict>
</plist>
