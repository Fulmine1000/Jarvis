<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.fulmine1000.jarvis</string>

    <!-- Guardiano vocale: ascolta la wake word senza avviare l'HUD all'accesso. -->
    <key>ProgramArguments</key>
    <array>
        <string>__JARVIS_PYTHON__</string>
        <string>__JARVIS_ROOT__/avvio/guardiano_wake.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__JARVIS_ROOT__</string>

    <!-- Solo nella sessione grafica dell'utente, non durante il boot di sistema. -->
    <key>LimitLoadToSessionType</key>
    <string>Aqua</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <!-- Il guardiano deve poter interagire con la sessione macOS quando apre l'HUD. -->
    <key>ProcessType</key>
    <string>Interactive</string>

    <key>ThrottleInterval</key>
    <integer>5</integer>

    <key>StandardOutPath</key>
    <string>__JARVIS_ROOT__/logs/guardiano_wake.log</string>

    <key>StandardErrorPath</key>
    <string>__JARVIS_ROOT__/logs/guardiano_wake_error.log</string>
</dict>
</plist>
